{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jekyll: serve",
      "type": "shell",
      "command": "bundle exec jekyll serve",
      "isBackground": true,
      "problemMatcher": {
        "owner": "jekyll",
        "pattern": {
          "regexp": "^\\s*(Error|Liquid Exception):\\s+(.*)$",
          "severity": 1,
          "message": 2
        },
        "background": {
          "beginsPattern": "Regenerating:|Generating\\.\\.\\.",
          "endsPattern": "Server running|\\.\\.\\.done in"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
